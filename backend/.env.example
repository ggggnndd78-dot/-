# Ghiyarak Backend Local Environment
# curl.exe -4 https://ifconfig.me/ip
# Copy this file to backend/.env locally. Never commit backend/.env to GitHub.

# MySQL local connection used by Prisma.
DATABASE_URL="mysql://root@localhost:3306/ghiyarak"

PORT=3000
NODE_ENV=development

# Request body limit. Required because provider verification documents are sent as Base64 JSON.
# Increase carefully if you allow larger PDFs/images.
REQUEST_BODY_LIMIT=30mb
JSON_BODY_LIMIT=30mb

# JWT real application secrets for local development. Change them before production.
JWT_ACCESS_SECRET="ghiyarak_local_access_secret_2026_real_auth_min_32_chars"
JWT_REFRESH_SECRET="ghiyarak_local_refresh_secret_2026_real_auth_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="30"

# OTP request protection. There is no fixed OTP code in this project.
OTP_LENGTH=6
OTP_MAX_REQUESTS_PER_10_MIN=5
OTP_TTL_MINUTES=5
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Browser clients allowed to call the backend.
# Important: keep this as plain URLs only. Do not use markdown links.
CORS_ORIGINS="http://localhost:4759,http://127.0.0.1:4759,http://localhost:2335,http://127.0.0.1:2335,http://localhost:11734,http://127.0.0.1:11734,http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080"

# Local default SMS provider prints OTP in the backend terminal for testing.
# For real SMS provider: CommPeak / TextPeak Streams API, set SMS_PROVIDER="COMMPEAK_EVENT_SEND" and fill the token below.
# Current working method verified from PowerShell:
# POST https://textpeak-streams.commpeak.com/event_send/
SMS_PROVIDER="CONSOLE"
COMMPEAK_SMS_EVENT_SEND_URL="https://textpeak-streams.commpeak.com/event_send/"
COMMPEAK_SMS_STATUS_URL="https://textpeak-streams.commpeak.com/messages_status/"

# Put the token from stream: Ghiyarak OTP Transactional.
# IMPORTANT: Never commit the real token to GitHub.
COMMPEAK_SMS_TOKEN="PASTE_NEW_GHIYARAK_OTP_TRANSACTIONAL_STREAM_TOKEN_HERE"

# Event key created inside the stream template.
# The event template content must use: {code}
COMMPEAK_SMS_EVENT_KEY="login_otp"

# Tested working sender. It may arrive as talabat until CommPeak fixes sender routing.
# Change to GHIYARAK after CommPeak binds the approved sender ID to this stream/route.
COMMPEAK_SMS_SENDER="GLOBAL"

# Phone formatting for CommPeak.
# Send numbers without +, example: 967781699203 or 966542634216
COMMPEAK_SMS_DEFAULT_COUNTRY_CODE="967"
COMMPEAK_SMS_PHONE_FORMAT="NO_PLUS"

# Old CommPeak endpoints - not used by SMS_PROVIDER=COMMPEAK_EVENT_SEND.
# COMMPEAK_SMS_AUTH_URL="https://textpeak-streams.commpeak.com/otp/auth/"
# COMMPEAK_SMS_VERIFY_URL="https://textpeak-streams.commpeak.com/otp/verify/"
# COMMPEAK_SMS_API_URL="https://sendsms.commpeak.com/simple_send/"

# Email notifications / approval messages. Console is safe for development.
# For real Gmail SMTP: use a Google App Password, not your normal Gmail password.
# The code supports both EMAIL_* and SMTP_* variable names.
EMAIL_PROVIDER="CONSOLE"
# EMAIL_PROVIDER="SMTP"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USERNAME="your-gmail@gmail.com"
# SMTP_PASSWORD="your_google_app_password_here"
# SMTP_FROM="Ghiyarak <your-gmail@gmail.com>"
# EMAIL_SMTP_HOST="smtp.gmail.com"
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER="your-gmail@gmail.com"
# EMAIL_SMTP_PASS="your_google_app_password_here"
# EMAIL_FROM="Ghiyarak <your-gmail@gmail.com>"

# Approval/rejection notifications can send EMAIL/BOTH. SMS notification sending is disabled by default
# to avoid using the OTP SMS stream for plain text messages. Enable only when a real notification SMS template/provider is configured.
NOTIFICATION_SMS_ENABLED="false"

# Phase 7 Firebase push notifications.
# Keep disabled locally unless you have a Firebase service account.
FIREBASE_PUSH_ENABLED="false"
# FIREBASE_SERVICE_ACCOUNT_JSON="{...}"
# FIREBASE_SERVICE_ACCOUNT_PATH="C:/secure/ghiyarak-firebase-service-account.json"

# Local manual test values.
TEST_PHONE="+967781699203"
TEST_EMAIL="hassannadim591@gmail.com"
TEST_PASSWORD="Ghiyarak@Test12345"

DEFAULT_LOCALE=ar
SUPPORTED_LOCALES=ar,en

# Phase 15 payment webhook verification.
# Use provider-specific secrets in production. Never commit real secrets.
PAYMENT_WEBHOOK_SECRET="CHANGE_ME_PAYMENT_WEBHOOK_SECRET_MIN_32_CHARS"
# PAYMENT_WEBHOOK_SECRET_PAYMENT_GATEWAY="CHANGE_ME_PROVIDER_SECRET"
# PAYMENT_WEBHOOK_SECRET_LOCAL_WALLET="CHANGE_ME_LOCAL_WALLET_SECRET"

# Final release / QA
SMOKE_BASE_URL="http://127.0.0.1:3000/api/v1"
APP_VERSION="2.0.0"
