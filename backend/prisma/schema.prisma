enum QaRunStatus {
  CREATED
  RUNNING
  PASSED
  FAILED
  BLOCKED
}

enum QaResultStatus {
  PASSED
  FAILED
  SKIPPED
  BLOCKED
}

enum ReleaseCheckStatus {
  PENDING
  PASSED
  FAILED
  WAIVED
}

enum DeploymentEnvironment {
  LOCAL
  STAGING
  PRODUCTION
}

model QaTestRun {
  id              Int            @id @default(autoincrement())
  runKey          String         @unique @map("run_key") @db.VarChar(80)
  title           String         @db.VarChar(180)
  status          QaRunStatus    @default(CREATED)
  scope           String         @default("FULL_SYSTEM") @db.VarChar(80)
  environment     DeploymentEnvironment @default(LOCAL)
  startedByUserId Int?           @map("started_by_user_id")
  startedAt       DateTime?      @map("started_at")
  finishedAt      DateTime?      @map("finished_at")
  summary         Json?          @map("summary_json")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  results         QaTestResult[]

  @@index([status, createdAt])
  @@index([environment, createdAt])
  @@map("qa_test_runs")
}

model QaTestResult {
  id          Int            @id @default(autoincrement())
  runId       Int            @map("run_id")
  suite       String         @db.VarChar(120)
  caseKey     String         @map("case_key") @db.VarChar(160)
  caseTitle   String         @map("case_title") @db.VarChar(240)
  status      QaResultStatus
  durationMs  Int?           @map("duration_ms")
  errorMessage String?       @map("error_message") @db.Text
  evidence    Json?          @map("evidence_json")
  createdAt   DateTime       @default(now()) @map("created_at")
  run         QaTestRun      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, suite, caseKey])
  @@index([suite, status])
  @@index([status, createdAt])
  @@map("qa_test_results")
}

model ReleaseChecklistItem {
  id               Int                @id @default(autoincrement())
  itemKey          String             @unique @map("item_key") @db.VarChar(120)
  moduleCode       String             @map("module_code") @db.VarChar(80)
  titleAr          String             @map("title_ar") @db.VarChar(220)
  titleEn          String             @map("title_en") @db.VarChar(220)
  description      String?            @db.Text
  status           ReleaseCheckStatus @default(PENDING)
  isRequired       Boolean            @default(true) @map("is_required")
  evidenceUrl      String?            @map("evidence_url") @db.VarChar(500)
  verifiedByUserId Int?               @map("verified_by_user_id")
  verifiedAt       DateTime?          @map("verified_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([moduleCode, status])
  @@index([isRequired, status])
  @@map("release_checklist_items")
}

model DeploymentRun {
  id                Int                   @id @default(autoincrement())
  deploymentKey     String                @unique @map("deployment_key") @db.VarChar(100)
  environment       DeploymentEnvironment
  version           String                @db.VarChar(80)
  status            String                @default("CREATED") @db.VarChar(30)
  commitSha         String?               @map("commit_sha") @db.VarChar(80)
  releaseNotes      String?               @map("release_notes") @db.Text
  startedByUserId   Int?                  @map("started_by_user_id")
  startedAt         DateTime?             @map("started_at")
  completedAt       DateTime?             @map("completed_at")
  metadata          Json?                 @map("metadata_json")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@index([environment, status])
  @@index([createdAt])
  @@map("deployment_runs")
}

model TranslationKey {
  id          Int                @id @default(autoincrement())
  key         String             @unique @db.VarChar(220)
  namespace   String             @default("app") @db.VarChar(80)
  description String?            @db.Text
  status      String             @default("PUBLISHED") @db.VarChar(30)
  isSystem    Boolean            @default(false) @map("is_system")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  values      TranslationValue[]

  @@index([namespace, status])
  @@map("translation_keys")
}

model TranslationValue {
  id               Int      @id @default(autoincrement())
  translationKeyId Int      @map("translation_key_id")
  locale           String   @db.VarChar(10)
  value            String   @db.Text
  status           String   @default("PUBLISHED") @db.VarChar(30)
  platform         String   @default("GLOBAL") @db.VarChar(40)
  publishedAt      DateTime? @map("published_at")
  updatedByUserId  Int?     @map("updated_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  translationKey   TranslationKey @relation(fields: [translationKeyId], references: [id], onDelete: Cascade)

  @@unique([translationKeyId, locale, platform])
  @@index([locale, status])
  @@index([platform, locale])
  @@map("translation_values")
}
