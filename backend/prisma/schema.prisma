  title           String                    @db.VarChar(180)
  channel         RetentionChannel          @default(IN_APP)
  audienceType    RetentionAudienceType     @default(ALL_CUSTOMERS) @map("audience_type")
  status          RetentionCampaignStatus   @default(DRAFT)
  messageTitle    String                    @map("message_title") @db.VarChar(160)
  messageBody     String                    @map("message_body") @db.VarChar(500)
  couponId        Int?                      @map("coupon_id")
  startsAt        DateTime?                 @map("starts_at")
  endsAt          DateTime?                 @map("ends_at")
  sentAt          DateTime?                 @map("sent_at")
  createdByUserId Int?                      @map("created_by_user_id")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  coupon          Coupon?                   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdBy       User?                     @relation("RetentionCampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  events          RetentionCampaignEvent[]

  @@index([status, audienceType])
  @@index([startsAt, endsAt])
  @@map("retention_campaigns")
}

model RetentionCampaignEvent {
  id          Int                  @id @default(autoincrement())
  campaignId  Int                  @map("campaign_id")
  userId      Int                  @map("user_id")
  status      RetentionEventStatus @default(QUEUED)
  deliveredAt DateTime?            @map("delivered_at")
  openedAt    DateTime?            @map("opened_at")
  failedReason String?             @map("failed_reason") @db.VarChar(500)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  campaign    RetentionCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId, status])
  @@map("retention_campaign_events")
}


model AuditLog {
