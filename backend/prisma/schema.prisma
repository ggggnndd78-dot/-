enum EventOutboxStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
  CANCELLED
}

model DomainEventRecord {
  id             Int             @id @default(autoincrement())
  publicId       String          @unique @default(cuid())
  name           String          @db.VarChar(120)
  aggregateType  String?         @map("aggregate_type") @db.VarChar(80)
  aggregateId    String?         @map("aggregate_id") @db.VarChar(120)
  actorUserId    Int?            @map("actor_user_id")
  source         String?         @db.VarChar(80)
  idempotencyKey String?         @unique @map("idempotency_key") @db.VarChar(160)
  payload        Json?           @map("payload_json")
  occurredAt     DateTime        @default(now()) @map("occurred_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  outboxItems    EventOutbox[]
  logs           EventLog[]

  @@index([name, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([actorUserId, createdAt])
  @@map("domain_events")
}

model EventOutbox {
  id             Int               @id @default(autoincrement())
  publicId       String            @unique @default(cuid())
  domainEventId  Int               @map("domain_event_id")
  eventName      String            @map("event_name") @db.VarChar(120)
  aggregateType  String?           @map("aggregate_type") @db.VarChar(80)
  aggregateId    String?           @map("aggregate_id") @db.VarChar(120)
  destination    String            @default("internal") @db.VarChar(80)
  payload        Json?             @map("payload_json")
  status         EventOutboxStatus @default(PENDING)
  attempts       Int               @default(0)
  lastError      String?           @map("last_error") @db.Text
  availableAt    DateTime          @default(now()) @map("available_at")
  processedAt    DateTime?         @map("processed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  domainEvent    DomainEventRecord @relation(fields: [domainEventId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([eventName, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("event_outbox")
}

model EventLog {
  id             Int               @id @default(autoincrement())
  publicId       String            @unique @default(cuid())
  domainEventId  Int               @map("domain_event_id")
  eventName      String            @map("event_name") @db.VarChar(120)
  status         String            @default("RECORDED") @db.VarChar(40)
  message        String?           @db.Text
  metadata       Json?             @map("metadata_json")
  createdAt      DateTime          @default(now()) @map("created_at")
  domainEvent    DomainEventRecord @relation(fields: [domainEventId], references: [id], onDelete: Cascade)

  @@index([domainEventId, createdAt])
  @@index([eventName, createdAt])
  @@index([status, createdAt])
  @@map("event_logs")
}



model ProductImportTemplate {
  id              Int                    @id @default(autoincrement())
  publicId        String                 @unique @default(cuid()) @map("public_id")
  name            String                 @db.VarChar(140)
  organizationType String?               @map("organization_type") @db.VarChar(30)
  requiredColumns Json                   @map("required_columns")
  optionalColumns Json?                  @map("optional_columns")
  sampleRows      Json?                  @map("sample_rows")
  isDefault       Boolean                @default(false) @map("is_default")
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  mappings        ProductImportMapping[]

  @@index([organizationType, isActive])
  @@map("product_import_templates")
}

model ProductImportMapping {
  id              Int                    @id @default(autoincrement())
  organizationId  Int?                   @map("organization_id")
  templateId      Int?                   @map("template_id")
  sourceColumn    String                 @map("source_column") @db.VarChar(120)
  targetField     String                 @map("target_field") @db.VarChar(120)
  isRequired      Boolean                @default(false) @map("is_required")
  defaultValue    String?                @map("default_value") @db.VarChar(255)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  organization    Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template        ProductImportTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([templateId])
  @@map("product_import_mappings")
}

model ProductImportJob {
  id                Int                  @id @default(autoincrement())
  publicId          String               @unique @default(cuid()) @map("public_id")
  organizationId    Int                  @map("organization_id")
  branchId          Int                  @map("branch_id")
  uploadedByUserId  Int                  @map("uploaded_by_user_id")
  fileName          String               @map("file_name") @db.VarChar(255)
  originalFileName  String               @map("original_file_name") @db.VarChar(255)
  fileMimeType      String?              @map("file_mime_type") @db.VarChar(120)
  fileSizeBytes     Int?                 @map("file_size_bytes")
  status            String               @default("UPLOADED") @db.VarChar(40)
  totalRows         Int                  @default(0) @map("total_rows")
  validRows         Int                  @default(0) @map("valid_rows")
  invalidRows       Int                  @default(0) @map("invalid_rows")
  importedRows      Int                  @default(0) @map("imported_rows")
  skippedRows       Int                  @default(0) @map("skipped_rows")
  currency          String               @default("YER") @db.VarChar(3)
  parsedAt          DateTime?            @map("parsed_at")
  confirmedAt       DateTime?            @map("confirmed_at")
  completedAt       DateTime?            @map("completed_at")
  failedReason      String?              @map("failed_reason") @db.Text
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch            OrganizationBranch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  uploadedBy        User                 @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  rows              ProductImportRow[]
  errors            ProductImportError[]

  @@index([organizationId, createdAt])
  @@index([branchId])
  @@index([uploadedByUserId])
  @@index([status])
  @@map("product_import_jobs")
}

model ProductImportRow {
  id              Int                  @id @default(autoincrement())
  jobId           Int                  @map("job_id")
  rowNumber       Int                  @map("row_number")
  status          String               @default("PENDING") @db.VarChar(40)
  rawData         Json                 @map("raw_data")
  normalizedData  Json?                @map("normalized_data")
  errorSummary    String?              @map("error_summary") @db.Text
  productId       Int?                 @map("product_id")
  listingId       Int?                 @map("listing_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  job             ProductImportJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product         CatalogProduct?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  listing         Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  errors          ProductImportError[]

  @@unique([jobId, rowNumber])
  @@index([jobId, status])
  @@index([productId])
  @@index([listingId])
  @@map("product_import_rows")
}

model ProductImportError {
  id          Int               @id @default(autoincrement())
  jobId       Int               @map("job_id")
  rowId       Int?              @map("row_id")
  fieldName   String?           @map("field_name") @db.VarChar(120)
  errorCode   String            @map("error_code") @db.VarChar(80)
  message     String            @db.VarChar(500)
  value       String?           @db.VarChar(500)
  severity    String            @default("ERROR") @db.VarChar(30)
  createdAt   DateTime          @default(now()) @map("created_at")
  job         ProductImportJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  row         ProductImportRow? @relation(fields: [rowId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([rowId])
  @@index([errorCode])
  @@map("product_import_errors")
}


// Phase 22: System hardening, unification, runtime i18n, and analytics snapshots.
