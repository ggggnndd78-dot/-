generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  EMPLOYEE_INVITE
  PASSWORD_RESET
}

enum OtpRequestStatus {
  PENDING
  CONSUMED
  EXPIRED
}

enum OrganizationType {
  MERCHANT
  WORKSHOP
  WAREHOUSE
}

enum OrganizationStatus {
  DRAFT
  PENDING_REVIEW
  DOCUMENTS_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}


enum OrganizationMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum EmployeeInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum VerificationRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  UNDER_REVIEW
  DOCUMENTS_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
  WITHDRAWN
}

enum VerificationDocumentType {
  COMMERCIAL_REGISTRATION
  SHOP_GUARANTEE
  NATIONAL_ID
  STORE_FRONT
  BANK_PROOF
  PASSPORT
  BANK_STATEMENT
  OTHER
}

model User {
  id                   Int                  @id @default(autoincrement())
  publicId             String               @unique @default(cuid())
  phoneE164            String?              @map("phone_e164") @db.VarChar(20)
  phoneNormalized      String?              @unique @map("phone_normalized") @db.VarChar(20)
  email                String?              @unique @db.VarChar(255)
  displayName          String?              @map("display_name") @db.VarChar(120)
  status               UserStatus           @default(ACTIVE)
  isPhoneVerified      Boolean              @default(false) @map("is_phone_verified")
  isEmailVerified      Boolean              @default(false) @map("is_email_verified")
  locale               String               @default("ar") @db.VarChar(10)
  failedLoginCount     Int                  @default(0) @map("failed_login_count")
  lockedUntil          DateTime?            @map("locked_until")
  lastLoginAt          DateTime?            @map("last_login_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  customerProfile      CustomerProfile?
  oauthAccounts        OauthAccount[]
  otpRequests          OtpRequest[]
  refreshTokens        RefreshToken[]
  userRoles            UserRole[]
  customerVehicles     CustomerVehicle[]
  organizationMembers  OrganizationMember[]
  submittedVerifications VerificationRequest[] @relation("VerificationSubmittedBy")
  reviewedVerifications  VerificationRequest[] @relation("VerificationReviewedBy")
  approvalActions      ApprovalAction[]
  verificationReviewNotes VerificationReviewNote[]
  verificationStatusChanges VerificationStatusHistory[]
  listings             Listing[]
  carts                Cart[]
  orders               Order[]
  orderStatusHistory   OrderStatusHistory[]
  createdWorkshopServices WorkshopService[] @relation("WorkshopServiceCreatedBy")
  createdServiceCategories ServiceCategory[] @relation("ServiceCategoryCreatedBy")
  createdServices ServiceCatalog[] @relation("ServiceCatalogCreatedBy")
  customerWorkshopBookings WorkshopBooking[] @relation("WorkshopBookingCustomer")
  workshopBookingStatusHistory WorkshopBookingStatusHistory[] @relation("WorkshopBookingChangedBy")
  workshopServiceOrders ServiceOrder[] @relation("ServiceOrderCustomer")
  serviceOrderStatusHistory ServiceOrderStatusHistory[] @relation("ServiceOrderChangedBy")
  workshopTechnicianProfiles WorkshopTechnician[] @relation("TechnicianUser")
  maintenanceRecords MaintenanceRecord[] @relation("MaintenanceRecordCustomer")
  paymentTransactions PaymentTransaction[] @relation("PaymentTransactionUser")
  approvedPaymentTransactions PaymentTransaction[] @relation("PaymentApprovedBy")
  uploadedPaymentProofs PaymentProof[] @relation("PaymentProofUploadedBy")
  reviewedPaymentProofs PaymentProof[] @relation("PaymentProofReviewedBy")
  requestedRefunds RefundRequest[] @relation("RefundRequestedBy")
  approvedRefunds RefundRequest[] @relation("RefundApprovedBy")
  approvedSettlements Settlement[] @relation("SettlementApprovedBy")
  postedJournalEntries JournalEntry[] @relation("JournalPostedBy")
  financialTransactions FinancialTransaction[] @relation("FinancialTransactionCustomer")
  invoices Invoice[] @relation("InvoiceCustomer")
  registeredDevices UserDevice[]
  notifications Notification[]
  emailNotificationLogs EmailNotificationLog[]
  pushNotificationLogs PushNotificationLog[]
  addresses Address[]
  createdShipments Shipment[] @relation("ShipmentCreatedBy")
  driverProfile Driver? @relation("DriverUser")
  shipmentEvents ShipmentTrackingEvent[] @relation("ShipmentEventCreatedBy")
  supportTickets SupportTicket[] @relation("SupportTicketRequester")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignee")
  supportMessages SupportTicketMessage[] @relation("SupportTicketMessageAuthor")
  uploadedSupportAttachments SupportTicketAttachment[] @relation("SupportAttachmentUploadedBy")
  complaints Complaint[] @relation("ComplaintRequester")
  resolvedComplaints Complaint[] @relation("ComplaintResolvedBy")
  createdHelpCenterCategories HelpCenterCategory[] @relation("HelpCenterCategoryCreatedBy")
  createdHelpCenterArticles HelpCenterArticle[] @relation("HelpCenterArticleCreatedBy")
  updatedHelpCenterArticles HelpCenterArticle[] @relation("HelpCenterArticleUpdatedBy")
  createdFaqs Faq[] @relation("FaqCreatedBy")
  createdWhatsappSupportLinks WhatsappSupportLink[] @relation("WhatsappSupportLinkCreatedBy")
  productReviews ProductReview[]
  merchantReviews MerchantReview[]
  workshopReviews WorkshopReview[]
  serviceReviews ServiceReview[]
  reviewReplies ReviewReply[] @relation("ReviewReplyAuthor")
  uploadedReviewMedia ReviewMedia[] @relation("ReviewMediaUploadedBy")
  reviewModerationActions ReviewModerationAction[] @relation("ReviewModerationActor")
  walletAccounts WalletAccount[]
  walletLedgerEntries WalletLedgerEntry[] @relation("WalletLedgerCreatedBy")
  loyaltyAccount LoyaltyAccount?
  loyaltyPointTransactions LoyaltyPointTransaction[] @relation("LoyaltyTransactionUser")
  createdLoyaltyTransactions LoyaltyPointTransaction[] @relation("LoyaltyTransactionCreatedBy")
  couponRedemptions CouponRedemption[]
  createdCoupons Coupon[] @relation("CouponCreatedBy")
  createdRetentionCampaigns RetentionCampaign[] @relation("RetentionCampaignCreatedBy")
  retentionCampaignEvents RetentionCampaignEvent[]
  referralCodes ReferralCode[] @relation("ReferralCodeOwner")
  referralsMade ReferralRelationship[] @relation("ReferralReferrer")
  referralsReceived ReferralRelationship[] @relation("ReferralReferred")
  referralRewards ReferralReward[] @relation("ReferralRewardUser")
  createdReferralRewards ReferralReward[] @relation("ReferralRewardCreatedBy")
  trustedDevices AuthTrustedDevice[]
  authSessions AuthSession[]
  productImportJobs ProductImportJob[]

  @@map("iam_users")
}

model OauthAccount {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  providerCode   String   @map("provider_code") @db.VarChar(30)
  providerUserId String   @map("provider_user_id") @db.VarChar(120)
  providerEmail  String?  @map("provider_email") @db.VarChar(255)
  linkedAt       DateTime @default(now()) @map("linked_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerCode, providerUserId])
  @@map("iam_oauth_accounts")
}

model OtpRequest {
  id          Int              @id @default(autoincrement())
  publicId    String           @unique @default(cuid())
  userId      Int?             @map("user_id")
  targetType  String           @map("target_type") @db.VarChar(20)
  targetValue String           @map("target_value") @db.VarChar(255)
  purpose     OtpPurpose
  otpHash     String           @map("otp_hash") @db.VarChar(255)
  expiresAt   DateTime         @map("expires_at")
  consumedAt  DateTime?        @map("consumed_at")
  attempts    Int              @default(0)
  maxAttempts Int              @default(5) @map("max_attempts")
  status      OtpRequestStatus @default(PENDING)
  ipAddress   String?          @map("ip_address") @db.VarChar(80)
  userAgent   String?          @map("user_agent") @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at")
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetType, targetValue, purpose, status, createdAt])
  @@index([userId, createdAt])
  @@map("iam_otp_requests")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  deviceId  Int?      @map("device_id")
  sessionId Int?      @map("session_id")
  ipAddress String?   @map("ip_address") @db.VarChar(80)
  userAgent String?   @map("user_agent") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    AuthTrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  session   AuthSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([deviceId])
  @@map("iam_refresh_tokens")
}


model AuthTrustedDevice {
  id                Int           @id @default(autoincrement())
  publicId          String        @unique @default(cuid())
  userId            Int           @map("user_id")
  deviceFingerprint String        @map("device_fingerprint") @db.VarChar(191)
  deviceTokenHash   String        @map("device_token_hash") @db.VarChar(255)
  deviceName        String?       @map("device_name") @db.VarChar(160)
  platform          String        @default("UNKNOWN") @db.VarChar(40)
  ipAddress         String?       @map("ip_address") @db.VarChar(80)
  userAgent         String?       @map("user_agent") @db.VarChar(500)
  status            String        @default("TRUSTED") @db.VarChar(30)
  trustedAt         DateTime      @default(now()) @map("trusted_at")
  lastUsedAt        DateTime?     @map("last_used_at")
  revokedAt         DateTime?     @map("revoked_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          AuthSession[]
  refreshTokens     RefreshToken[]

  @@unique([userId, deviceFingerprint])
  @@index([userId, status, revokedAt])
  @@index([deviceFingerprint])
  @@map("auth_trusted_devices")
}

model AuthSession {
  id              Int                @id @default(autoincrement())
  publicId        String             @unique @default(cuid())
  userId          Int                @map("user_id")
  deviceId        Int?               @map("device_id")
  status          String             @default("ACTIVE") @db.VarChar(30)
  ipAddress       String?            @map("ip_address") @db.VarChar(80)
  userAgent       String?            @map("user_agent") @db.VarChar(500)
  permissionsHash String?            @map("permissions_hash") @db.VarChar(128)
  expiresAt       DateTime?          @map("expires_at")
  revokedAt       DateTime?          @map("revoked_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  lastSeenAt      DateTime           @default(now()) @map("last_seen_at")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  device          AuthTrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens   RefreshToken[]

  @@index([userId, status, createdAt])
  @@index([deviceId, status])
  @@map("auth_sessions")
}

model GuestSession {
  id               Int       @id @default(autoincrement())
  publicId         String    @unique @default(cuid())
  guestTokenHash   String    @map("guest_token_hash") @db.VarChar(255)
  cityId           Int?      @map("city_id")
  districtId       Int?      @map("district_id")
  areaId           Int?      @map("area_id")
  consumedByUserId Int?      @map("consumed_by_user_id")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  city             City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  district         District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  area             Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@map("iam_guest_sessions")
}

model Role {
  id              Int              @id @default(autoincrement())
  code            String           @unique @db.VarChar(50)
  name            String           @db.VarChar(100)
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("iam_roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique @db.VarChar(80)
  name            String           @db.VarChar(120)
  moduleCode      String           @map("module_code") @db.VarChar(50)
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@map("iam_permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("iam_role_permissions")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("iam_user_roles")
}

model CustomerProfile {
  id               Int               @id @default(autoincrement())
  userId           Int               @unique @map("user_id")
  displayName      String?           @map("display_name") @db.VarChar(120)
  cityId           Int?              @map("city_id")
  districtId       Int?              @map("district_id")
  areaId           Int?              @map("area_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  city             City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  district         District?         @relation(fields: [districtId], references: [id], onDelete: SetNull)
  area             Area?             @relation(fields: [areaId], references: [id], onDelete: SetNull)
  addresses        CustomerAddress[]

  @@map("crm_customer_profiles")
}

model CustomerAddress {
  id                Int             @id @default(autoincrement())
  customerProfileId Int             @map("customer_profile_id")
  label             String          @db.VarChar(60)
  recipientName     String          @map("recipient_name") @db.VarChar(120)
  phone             String          @db.VarChar(20)
  cityId            Int             @map("city_id")
  districtId        Int?            @map("district_id")
  areaId            Int?            @map("area_id")
  addressLine1      String          @map("address_line_1") @db.VarChar(255)
  isDefault         Boolean         @default(false) @map("is_default")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  city              City            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  district          District?       @relation(fields: [districtId], references: [id], onDelete: SetNull)
  area              Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@map("crm_customer_addresses")
}

model Country {
  id        Int      @id @default(autoincrement())
  isoCode   String   @unique @map("iso_code") @db.VarChar(3)
  nameAr    String   @map("name_ar") @db.VarChar(120)
  nameEn    String?  @map("name_en") @db.VarChar(120)
  phoneCode String?  @map("phone_code") @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  states    State[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("geo_countries")
}

model State {
  id       Int      @id @default(autoincrement())
  countryId Int     @map("country_id")
  nameAr   String   @map("name_ar") @db.VarChar(120)
  nameEn   String?  @map("name_en") @db.VarChar(120)
  code     String?  @db.VarChar(20)
  isActive Boolean  @default(true) @map("is_active")
  country  Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities   City[]

  @@map("geo_states")
}

model City {
  id                  Int                  @id @default(autoincrement())
  stateId             Int                  @map("state_id")
  nameAr              String               @map("name_ar") @db.VarChar(120)
  nameEn              String?              @map("name_en") @db.VarChar(120)
  code                String?              @db.VarChar(20)
  isActive            Boolean              @default(true) @map("is_active")
  state               State                @relation(fields: [stateId], references: [id], onDelete: Restrict)
  districts           District[]
  customerProfiles    CustomerProfile[]
  customerAddresses   CustomerAddress[]
  guestSessions       GuestSession[]
  organizationBranches OrganizationBranch[]
  listings             Listing[]
  orders               Order[]
  serviceCategories    ServiceCategory[]
  serviceCatalog        ServiceCatalog[]
  workshopServices      WorkshopService[]
  workshopBookings      WorkshopBooking[]
  shipments           Shipment[]
  localShippingCompanies LocalShippingCompany[]
  drivers             Driver[]
  deliveryFees        DeliveryFee[]
  addresses           Address[]
  deliveryZones       DeliveryZone[]
  deliveryFee         CityDeliveryFee?

  @@map("geo_cities")
}

model District {
  id                  Int                  @id @default(autoincrement())
  cityId              Int                  @map("city_id")
  nameAr              String               @map("name_ar") @db.VarChar(120)
  nameEn              String?              @map("name_en") @db.VarChar(120)
  isActive            Boolean              @default(true) @map("is_active")
  city                City                 @relation(fields: [cityId], references: [id], onDelete: Restrict)
  areas               Area[]
  customerProfiles    CustomerProfile[]
  customerAddresses   CustomerAddress[]
  guestSessions       GuestSession[]
  organizationBranches OrganizationBranch[]
  addresses           Address[]
  deliveryZones       DeliveryZone[]

  @@map("geo_districts")
}

model Area {
  id                  Int                  @id @default(autoincrement())
  districtId          Int                  @map("district_id")
  nameAr              String               @map("name_ar") @db.VarChar(120)
  nameEn              String?              @map("name_en") @db.VarChar(120)
  isActive            Boolean              @default(true) @map("is_active")
  district            District             @relation(fields: [districtId], references: [id], onDelete: Restrict)
  customerProfiles    CustomerProfile[]
  customerAddresses   CustomerAddress[]
  guestSessions       GuestSession[]
  organizationBranches OrganizationBranch[]
  addresses           Address[]

  @@map("geo_areas")
}

model Address {
  id             Int       @id @default(autoincrement())
  publicId       String    @unique @default(cuid()) @map("public_id")
  userId         Int       @map("user_id")
  label          String    @db.VarChar(60)
  recipientName  String    @map("recipient_name") @db.VarChar(120)
  phone          String    @db.VarChar(20)
  cityId         Int       @map("city_id")
  districtId     Int?      @map("district_id")
  areaId         Int?      @map("area_id")
  addressLine1   String    @map("address_line_1") @db.VarChar(255)
  addressLine2   String?   @map("address_line_2") @db.VarChar(255)
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  isDefault      Boolean   @default(false) @map("is_default")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city           City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  district       District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  area           Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([cityId])
  @@map("addresses")
}

model DeliveryZone {
  id               Int       @id @default(autoincrement())
  publicId         String    @unique @default(cuid()) @map("public_id")
  cityId           Int       @map("city_id")
  districtId       Int?      @map("district_id")
  nameAr           String    @map("name_ar") @db.VarChar(120)
  nameEn           String?   @map("name_en") @db.VarChar(120)
  code             String?   @db.VarChar(40)
  deliveryFee      Decimal   @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  currency         String    @default("YER") @db.VarChar(3)
  estimatedMinDays Int?      @map("estimated_min_days")
  estimatedMaxDays Int?      @map("estimated_max_days")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  city             City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  district         District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@index([cityId])
  @@index([districtId])
  @@map("delivery_zones")
}

model CityDeliveryFee {
  id                  Int      @id @default(autoincrement())
  cityId              Int      @unique @map("city_id")
  deliveryFee         Decimal  @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  currency            String   @default("YER") @db.VarChar(3)
  isDeliveryAvailable Boolean  @default(true) @map("is_delivery_available")
  estimatedMinDays    Int?     @map("estimated_min_days")
  estimatedMaxDays    Int?     @map("estimated_max_days")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  city                City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@map("city_delivery_fees")
}

model VehicleMake {
  id               Int               @id @default(autoincrement())
  nameAr           String            @map("name_ar") @db.VarChar(120)
  nameEn           String?           @map("name_en") @db.VarChar(120)
  slug             String            @unique @db.VarChar(140)
  isActive         Boolean           @default(true) @map("is_active")
  models           VehicleModel[]
  customerVehicles CustomerVehicle[]
  productCompatibilities ProductCompatibility[]

  @@map("vehicle_makes")
}

model VehicleModel {
  id               Int               @id @default(autoincrement())
  makeId           Int               @map("make_id")
  nameAr           String            @map("name_ar") @db.VarChar(120)
  nameEn           String?           @map("name_en") @db.VarChar(120)
  slug             String            @db.VarChar(140)
  isActive         Boolean           @default(true) @map("is_active")
  make             VehicleMake       @relation(fields: [makeId], references: [id], onDelete: Restrict)
  generations      VehicleGeneration[]
  variants         VehicleVariant[]
  customerVehicles CustomerVehicle[]
  productCompatibilities ProductCompatibility[]

  @@map("vehicle_models")
}

model VehicleGeneration {
  id             Int              @id @default(autoincrement())
  modelId        Int              @map("model_id")
  generationName String           @map("generation_name") @db.VarChar(120)
  yearFrom       Int              @map("year_from")
  yearTo         Int?             @map("year_to")
  model          VehicleModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  variants       VehicleVariant[]

  @@map("vehicle_generations")
}

model VehicleVariant {
  id               Int               @id @default(autoincrement())
  modelId          Int               @map("model_id")
  generationId     Int?              @map("generation_id")
  trimName         String            @map("trim_name") @db.VarChar(120)
  yearFrom         Int               @map("year_from")
  yearTo           Int?              @map("year_to")
  transmissionType String?           @map("transmission_type") @db.VarChar(30)
  fuelType         String?           @map("fuel_type") @db.VarChar(30)
  isActive         Boolean           @default(true) @map("is_active")
  model            VehicleModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  generation       VehicleGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  customerVehicles CustomerVehicle[]
  productCompatibilities ProductCompatibility[]

  @@map("vehicle_variants")
}

model CustomerVehicle {
  id         Int             @id @default(autoincrement())
  publicId   String          @unique @default(cuid())
  userId     Int             @map("user_id")
  nickname   String?         @db.VarChar(80)
  makeId     Int             @map("make_id")
  modelId    Int             @map("model_id")
  variantId  Int?            @map("variant_id")
  yearValue  Int             @map("year_value")
  isDefault  Boolean         @default(false) @map("is_default")
