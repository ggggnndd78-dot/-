enum SupportTicketCategory {
  GENERAL
  ORDER
  PAYMENT
  DELIVERY
  WORKSHOP
  MERCHANT
  TECHNICAL
  COMPLAINT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_SUPPORT
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  ESCALATED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportMessageType {
  CUSTOMER_MESSAGE
  SUPPORT_MESSAGE
  MERCHANT_MESSAGE
  SYSTEM_NOTE
  INTERNAL_NOTE
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  INVESTIGATION
  WAITING_CUSTOMER
  WAITING_PROVIDER
  RESOLVED
  REJECTED
  CLOSED
}

enum ComplaintSeverity {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum SupportContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WhatsappSupportDepartment {
  SALES
  SUPPORT
  COMPLAINTS
  TECHNICAL
  FINANCE
  GENERAL
}

enum SupportAttachmentScope {
  TICKET
  MESSAGE
  COMPLAINT
}

enum ReviewTargetType {
  PRODUCT
  MERCHANT
  WORKSHOP
  SERVICE
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum ReviewModerationActionType {
  REPORTED
  HIDDEN
  RESTORED
  REJECTED
}

enum ReviewReplyStatus {
  PUBLISHED
  HIDDEN
}

model SupportTicket {
  id              Int                   @id @default(autoincrement())
  publicId        String                @unique @default(cuid())
  ticketNumber    String                @unique @map("ticket_number") @db.VarChar(40)
  requesterUserId Int                   @map("requester_user_id")
  assignedUserId  Int?                  @map("assigned_user_id")
  organizationId  Int?                  @map("organization_id")
  orderId         Int?                  @map("order_id")
  serviceOrderId  Int?                  @map("service_order_id")
  paymentId       Int?                  @map("payment_id")
  shipmentId      Int?                  @map("shipment_id")
  category        SupportTicketCategory @default(GENERAL)
  status          SupportTicketStatus   @default(OPEN)
  priority        SupportTicketPriority @default(NORMAL)
  subject         String                @db.VarChar(180)
  description     String                @db.Text
  lastMessageAt   DateTime?             @map("last_message_at")
  resolvedAt      DateTime?             @map("resolved_at")
  closedAt        DateTime?             @map("closed_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  requester       User                  @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  assignedUser    User?                 @relation("SupportTicketAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  organization    Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  serviceOrder    ServiceOrder?         @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  payment         PaymentTransaction?   @relation("SupportTicketPayment", fields: [paymentId], references: [id], onDelete: SetNull)
  shipment        Shipment?             @relation("SupportTicketShipment", fields: [shipmentId], references: [id], onDelete: SetNull)
  messages        SupportTicketMessage[]
  attachments     SupportTicketAttachment[]
  complaint       Complaint?

  @@index([requesterUserId, status])
  @@index([organizationId, status])
  @@index([paymentId, status])
  @@index([shipmentId, status])
  @@index([assignedUserId, status])
  @@index([category, status])
  @@index([ticketNumber])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id              Int                @id @default(autoincrement())
  publicId        String             @unique @default(cuid())
  ticketId        Int                @map("ticket_id")
  authorUserId    Int?               @map("author_user_id")
  messageType     SupportMessageType @default(CUSTOMER_MESSAGE) @map("message_type")
  body            String             @db.Text
  attachments     Json?
  isInternal      Boolean            @default(false) @map("is_internal")
  createdAt       DateTime           @default(now()) @map("created_at")
  ticket          SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author          User?              @relation("SupportTicketMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  attachmentRecords SupportTicketAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorUserId])
  @@map("support_ticket_messages")
}

model Complaint {
  id              Int               @id @default(autoincrement())
  publicId        String            @unique @default(cuid())
  complaintNumber String            @unique @map("complaint_number") @db.VarChar(40)
  requesterUserId Int               @map("requester_user_id")
  organizationId  Int?              @map("organization_id")
  orderId         Int?              @map("order_id")
  serviceOrderId  Int?              @map("service_order_id")
  paymentId       Int?              @map("payment_id")
  shipmentId      Int?              @map("shipment_id")
  ticketId        Int?              @unique @map("ticket_id")
  status          ComplaintStatus   @default(SUBMITTED)
  severity        ComplaintSeverity @default(NORMAL)
  subject         String            @db.VarChar(180)
  description     String            @db.Text
  resolutionNote  String?           @map("resolution_note") @db.Text
  resolvedByUserId Int?             @map("resolved_by_user_id")
  resolvedAt      DateTime?         @map("resolved_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  requester       User              @relation("ComplaintRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  serviceOrder    ServiceOrder?     @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)
  payment         PaymentTransaction? @relation("ComplaintPayment", fields: [paymentId], references: [id], onDelete: SetNull)
  shipment        Shipment?         @relation("ComplaintShipment", fields: [shipmentId], references: [id], onDelete: SetNull)
  ticket          SupportTicket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  resolvedBy      User?             @relation("ComplaintResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([requesterUserId, status])
  @@index([organizationId, status])
  @@index([paymentId, status])
  @@index([shipmentId, status])
  @@index([severity, status])
  @@map("support_complaints")
}

model SupportTicketAttachment {
  id              Int                    @id @default(autoincrement())
